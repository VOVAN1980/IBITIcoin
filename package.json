{
  "name": "ibiticoin-v2",
  "version": "2.0.0",
  "description": "IBITIcoin V2 — fixed-supply BEP-20 without owner powers",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:fork": "hardhat test test/fork/*.js",
    "coverage": "hardhat coverage",
    "preflight:testnet": "hardhat run scripts/00-preflight.js --network bscTestnet",
    "deploy:testnet": "hardhat run scripts/01-deploy.js --network bscTestnet",
    "check:testnet": "hardhat run scripts/02-post-deploy-check.js --network bscTestnet",
    "preflight:mainnet": "hardhat run scripts/00-preflight.js --network bsc",
    "deploy:mainnet": "hardhat run scripts/01-deploy.js --network bsc",
    "check:mainnet": "hardhat run scripts/02-post-deploy-check.js --network bsc",
    "verify:testnet": "hardhat run scripts/03-verify.js --network bscTestnet",
    "verify:mainnet": "hardhat run scripts/03-verify.js --network bsc",
    "liquidity:testnet": "hardhat run scripts/04-add-liquidity.js --network bscTestnet",
    "liquidity:mainnet": "hardhat run scripts/04-add-liquidity.js --network bscLiquidity"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ledger": "^1.2.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.1",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "chai": "^4.3.7",
    "dotenv": "^16.3.1",
    "ethers": "^6.13.5",
    "hardhat": "^2.16.1",
    "hardhat-contract-sizer": "^2.10.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.3"
  }
}
