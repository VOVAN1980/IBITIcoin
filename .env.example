# Скопировать в .env и заполнить. .env в git не попадает.
# Приватные ключи mainnet здесь НЕ хранятся: mainnet подписывается только Ledger.

# --- Кошельки Ledger (только адреса) ---
# Ledger Казна: 70 млн, ликвидность и биржи
FOUNDER_WALLET=
# Ledger Основной: 20 млн, маркетинг и резерв
RESERVE_WALLET=
# Ledger Вестинг: владелец контракта вестинга (10 млн)
VESTING_WALLET=
# С какого Ledger идёт деплой
DEPLOYER_LEDGER=
# С какого Ledger добавляется ликвидность
LIQUIDITY_LEDGER=

# --- Сеть ---
# mainnet
BSC_MAINNET_RPC_URL=
# testnet
BSC_RPC_URL=
# архивный узел: история и тесты на копии BSC
BSC_ARCHIVE_RPC_URL=

# --- Ключи ---
# BscScan, API v2
ETHERSCAN_V2_KEY=
# только testnet. Пусто = подпись на Ledger
PRIVATE_KEY=

# --- Testnet ---
# С какого Ledger подписывать на testnet
TESTNET_LEDGER=
# Тестовый USDT с 18 знаками, как настоящий
TESTNET_USDT=

# --- Только при запуске теста на копии BSC, в .env не держать: иначе npm test пойдёт в сеть ---
# FORK_RPC_URL=
# FORK_BLOCK=
